NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_MEILISEARCH_API_KEY=your_meilisearch_api_key
NEXT_PUBLIC_MEILISEARCH_URL=http://localhost:7700
NEXT_PULBIC_GOOGLE_CLIENT_ID=your_google_client_id

# Video CDN host. Read in next.config.ts to allow-list the host for next/image.
# CloudFront fronts VIDEO only; images are served straight from S3.
CLOUDFRONT_BASE_URL=https://xxxxxxxx.cloudfront.net
# S3 host images are served from, allow-listed for next/image.
NEXT_PUBLIC_S3_IMAGE_HOST=your-bucket.s3.your-region.amazonaws.com
